<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="Version.props" />

    <!--
      HKRLEnvMod — Hollow Knight environment-server mod (HK Modding API).
      See docs/setup_guide.md for installation and build instructions.
    -->

    <PropertyGroup>
      <TargetFramework>net472</TargetFramework>
      <LangVersion>latest</LangVersion>
      <AssemblyName>HKRLEnvMod</AssemblyName>
      <RootNamespace>HKRLEnvMod</RootNamespace>
      <Nullable>enable</Nullable>
      <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
      <!-- Override via -p:HollowKnightManaged="/path/to/Hollow Knight/hollow_knight_Data/Managed" -->
      <HollowKnightManaged Condition="'$(HollowKnightManaged)' == ''">$(MSBuildProjectDirectory)\..\..\.refs\Managed</HollowKnightManaged>
    </PropertyGroup>

  <ItemGroup>
    <!-- Hollow Knight + Unity + Modding API assemblies (resolved from the local install). -->
    <Reference Include="Assembly-CSharp">
      <HintPath>$(HollowKnightManaged)/Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(HollowKnightManaged)/UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(HollowKnightManaged)/UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule"
               Condition="Exists('$(HollowKnightManaged)/UnityEngine.IMGUIModule.dll')">
      <HintPath>$(HollowKnightManaged)/UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.Physics2DModule"
               Condition="Exists('$(HollowKnightManaged)/UnityEngine.Physics2DModule.dll')">
      <HintPath>$(HollowKnightManaged)/UnityEngine.Physics2DModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="MMHOOK_Assembly-CSharp">
      <HintPath>$(HollowKnightManaged)/MMHOOK_Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="PlayMaker">
      <HintPath>$(HollowKnightManaged)/PlayMaker.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- FlatBuffers C# runtime + (generated) bindings. Generated code under
         Schema/ is gitignored; run `make gen-schema-cs`. -->
    <PackageReference Include="Google.FlatBuffers" Version="23.5.26" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net472" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
